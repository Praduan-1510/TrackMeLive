{
  "name": "trackmelive-backend-tests",
  "private": true,
  "description": "Emulator tests for Track Me Live: Firestore rules and Cloud Functions.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"src/**/*.test.ts\"",
    "test:contract": "node --test --disable-warning=ExperimentalWarning src/contract.test.ts",
    "test:rules": "node --test --disable-warning=ExperimentalWarning src/rules.test.ts",
    "test:functions": "node --test --disable-warning=ExperimentalWarning src/createSession.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.5",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "typescript": "6.0.3"
  }
}
