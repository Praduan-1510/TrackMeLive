rules_version = '2';

// Track Me Live: Firestore security rules (FSD §5, §6, §8).
//
// Deny by default: a request that matches no allow below is refused. Cloud
// Functions use the Admin SDK and bypass these rules. They alone create, end and
// delete sessions, and write users, call_active, call_ended_at, cleaned_at, the
// private/meta owner, token hash and viewer, callLogs and viewerSignIns
// (x-decisions Q-SESSION-CALLABLES in code/shared/schema/schema.json).
//
// Who is asking:
//   - a sharer signs in with a phone number (FSD §5);
//   - a viewer page signs in with a custom token from redeemLinkToken carrying the
//     claims {sid, role}: role 'viewer' for the first browser (private/meta.viewer_uid),
//     'watcher' for every later one (shared ViewerClaims).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who is asking ---------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isSharer() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'phone';
    }

    function isUser(userId) {
      return isSharer() && request.auth.uid == userId;
    }

    // The sharer still has a profile. A deleted account's ID token stays valid
    // for up to an hour, and rules can't see Auth; deleteAccount removes the
    // profile, and only saveProfile (which refuses an ended sign-in) makes one.
    function hasProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // A viewer page signed in for this one session, as viewer or watcher.
    function isViewerOf(sessionId) {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && request.auth.token.sid == sessionId
        && request.auth.token.role in ['viewer', 'watcher'];
    }

    // The session's viewer: the first browser, the only one that can share back.
    function isShareBackViewer(sessionId) {
      return isViewerOf(sessionId)
        && request.auth.token.role == 'viewer'
        && exists(metaPath(sessionId))
        && meta(sessionId).viewer_uid == request.auth.uid;
    }

    // ---- Sessions --------------------------------------------------------

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/shareSessions/$(sessionId);
    }

    function metaPath(sessionId) {
      return /databases/$(database)/documents/shareSessions/$(sessionId)/private/meta;
    }

    function session(sessionId) {
      return get(sessionPath(sessionId)).data;
    }

    // The session as it will be after this write: a batch that also updates the
    // session (a check-in, or applying precision_next) is judged by what it sets.
    function sessionAfter(sessionId) {
      return getAfter(sessionPath(sessionId)).data;
    }

    function meta(sessionId) {
      return get(metaPath(sessionId)).data;
    }

    // The owner lives only in private/meta.user_id, never on the session doc.
    function ownsSession(sessionId) {
      return isSharer()
        && exists(metaPath(sessionId))
        && meta(sessionId).user_id == request.auth.uid;
    }

    // Live: active and before both its stop time and its 1-hour limit. From
    // stop_at or expires_at on, it's over, even before the stop job marks it
    // stopped (x-decisions Q-SESSION-END).
    function isLive(s) {
      return s.status == 'active'
        && request.time < s.expires_at
        && (s.stop_at == null || request.time < s.stop_at);
    }

    // SHARE_BACK_FRESHNESS_SECONDS: the sharer's app checked in under 2 minutes ago.
    function checkedInRecently(s) {
      return request.time < s.last_ping_at + duration.value(120, 's');
    }

    // Share back is open: live, allowed for this session, and during its call
    // (FSD §6 Viewer access).
    function shareBackOpen(s) {
      return isLive(s)
        && s.share_back_allowed == true
        && s.call_active == true
        && s.call_ended_at == null
        && checkedInRecently(s);
    }

    // ---- Updates ---------------------------------------------------------

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanges(keys) {
      return changedKeys().hasOnly(keys);
    }

    function changes(key) {
      return key in changedKeys();
    }

    // The sharer's app writes only these session fields, and only while the
    // session is live. Ending it, and call_active / call_ended_at, go through
    // stopSession, reportCallEnded and reportCallActive.
    function isSharerSessionUpdate(sessionId) {
      return ownsSession(sessionId)
        && isLive(resource.data)
        && onlyChanges(['last_ping_at', 'ping_interval_s', 'precision', 'precision_next',
                        'stop_rule', 'stop_minutes', 'stop_at', 'share_back_requested_at'])
        && validCheckIn(request.resource.data)
        && validPingInterval(request.resource.data)
        && validPrecision(request.resource.data)
        && validStopRule(resource.data, request.resource.data)
        && validAskToShare(resource.data, request.resource.data);
    }

    // A check-in carries the server's time, never the phone's.
    function validCheckIn(after) {
      return !changes('last_ping_at') || after.last_ping_at == request.time;
    }

    // MAX_PING_INTERVAL_SECONDS: never fewer than 1 ping per 60 s.
    function validPingInterval(after) {
      return !changes('ping_interval_s')
        || (after.ping_interval_s is number
            && after.ping_interval_s > 0
            && after.ping_interval_s <= 60);
    }

    function validPrecision(after) {
      return after.precision in ['precise', 'approximate']
        && (after.precision_next == null || after.precision_next in ['precise', 'approximate']);
    }

    // The timer sheet (FSD §4 Stop rule): a timer ends in the future and never
    // after the 1-hour limit; "At the 1-hour limit" is the limit itself; "When the
    // call ends" only on a call share whose call hasn't ended.
    function validStopRule(before, after) {
      return !changedKeys().hasAny(['stop_rule', 'stop_minutes', 'stop_at'])
        || (after.stop_rule == 'minutes'
            && after.stop_minutes in [15, 30, 60]
            && after.stop_at is timestamp
            && after.stop_at > request.time
            && after.stop_at <= before.expires_at)
        || (after.stop_rule == 'limit'
            && after.stop_minutes == null
            && after.stop_at == before.expires_at)
        || (after.stop_rule == 'call'
            && after.stop_minutes == null
            && after.stop_at == null
            && before.call_id != null
            && before.call_ended_at == null);
    }

    // Ask to share (FSD §4): once per call, during the call, with share back
    // allowed, after the viewer has opened the link.
    function validAskToShare(before, after) {
      return !changes('share_back_requested_at')
        || (before.share_back_requested_at == null
            && after.share_back_requested_at == request.time
            && before.share_back_allowed == true
            && before.call_active == true
            && before.call_ended_at == null
            && before.first_viewed_at != null);
    }

    // The viewer turns share back on while it's open, or off at any time.
    function isViewerSessionUpdate(sessionId) {
      return isShareBackViewer(sessionId)
        && onlyChanges(['viewer_sharing'])
        && request.resource.data.viewer_sharing is bool
        && (request.resource.data.viewer_sharing == false || shareBackOpen(resource.data));
    }

    // ---- Shapes ----------------------------------------------------------

    // APPROXIMATE_ROUNDING_METERS in the shared schema.
    function minAccuracyFor(precision) {
      return precision == 'approximate' ? 500 : 0;
    }

    // A ping: exactly lat, lng, recorded_at, accuracy_m (shared Ping).
    function validPing(d, precision) {
      return d.keys().hasOnly(['lat', 'lng', 'recorded_at', 'accuracy_m'])
        && d.keys().hasAll(['lat', 'lng', 'recorded_at', 'accuracy_m'])
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.recorded_at is timestamp
        && d.recorded_at <= request.time + duration.value(1, 'm')
        && d.accuracy_m is number
        && d.accuracy_m >= minAccuracyFor(precision);
    }

    // An APNs, FCM or Live Activity token.
    function validToken(t) {
      return t is string && t.size() > 0 && t.size() <= 4096;
    }

    // users/{userId}/devices/{deviceId} (shared Device). Only iOS has a Live
    // Activity push-to-start token.
    function validDevice(d) {
      return d.keys().hasOnly(['platform', 'push_token', 'live_activity_start_token', 'updated_at'])
        && d.keys().hasAll(['platform', 'push_token', 'live_activity_start_token', 'updated_at'])
        && d.platform in ['ios', 'android']
        && validToken(d.push_token)
        && (d.live_activity_start_token == null
            || (d.platform == 'ios' && validToken(d.live_activity_start_token)))
        && d.updated_at == request.time;
    }

    // ---- Collections (FSD §6) ----------------------------------------------

    // Profiles: the owner reads; saveProfile and the session functions write.
    match /users/{userId} {
      allow get: if isUser(userId);

      // One per signed-in phone, for alerts; deleted at sign-out (FSD §8).
      // Registered only once the profile exists.
      match /devices/{deviceId} {
        allow get, delete: if isUser(userId);
        allow create, update: if isUser(userId) && hasProfile(userId) && validDevice(request.resource.data);
      }

      // trustedContacts: v2, unused in v1. No rule.
    }

    // Only what the viewer may see. No client lists, creates or deletes sessions.
    match /shareSessions/{sessionId} {
      // The viewer keeps reading the session doc after the end, for the ended state.
      allow get: if ownsSession(sessionId) || isViewerOf(sessionId);
      allow update: if isSharerSessionUpdate(sessionId) || isViewerSessionUpdate(sessionId);

      // Sharer-only: never readable by the viewer.
      match /private/{docId} {
        allow get: if docId == 'meta' && ownsSession(sessionId);
        // This session's iOS Live Activity update token.
        allow update: if docId == 'meta'
          && ownsSession(sessionId)
          && isLive(session(sessionId))
          && onlyChanges(['activity_push_token'])
          && (request.resource.data.activity_push_token == null
              || validToken(request.resource.data.activity_push_token));
      }

      // The sharer's locations. While Approximate, accuracy_m is at least 500 m,
      // so a ping never reveals more than the viewer sees (decided Oct 18).
      // Viewer and watcher read them only while the session is live.
      match /pings/{pingId} {
        allow read: if ownsSession(sessionId)
          || (isViewerOf(sessionId) && isLive(session(sessionId)));
        allow create: if ownsSession(sessionId)
          && isLive(sessionAfter(sessionId))
          && validPing(request.resource.data, sessionAfter(sessionId).precision);
      }

      // The viewer's shared-back locations: only the viewer writes them, while
      // share back is open and viewer_sharing is on (as written in the same
      // batch); only the sharer reads them.
      match /viewerPings/{pingId} {
        allow read: if ownsSession(sessionId);
        allow create: if isShareBackViewer(sessionId)
          && shareBackOpen(sessionAfter(sessionId))
          && sessionAfter(sessionId).viewer_sharing == true
          && validPing(request.resource.data, 'precise');
      }

      // viewerSignIns: function-only. No rule.
    }

    // The character library, seeded from the shared MASCOT_CATALOG.
    match /mascots/{mascotId} {
      allow read: if true;
    }

    // callLogs (createSession): function-only. No rule.
  }
}
