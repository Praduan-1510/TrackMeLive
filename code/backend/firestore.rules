rules_version = '2';

// Track Me Live: Firestore security rules.
//
// Sprint 0: deny everything by default. A request that matches no allow below
// is denied. Sessions are created only by the createSession Cloud Function
// (Admin SDK, which bypasses these rules); clients never create, change or
// delete a session. Two things are allowed:
//   1. the sharer reads their own session and its private/meta (FSD §6);
//   2. the sharer writes pings to their own live session, and while the
//      session is Approximate a ping's accuracy_m is at least 500 m, so a ping
//      never reveals more than the viewer sees (decided Oct 18; the app writes
//      max(raw GPS accuracy, 500)).
//
// Below the live rules is the commented Sprint 1 plan, one block per
// collection in FSD §6, with §8's retention and deletion.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers --------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // Sharers sign in with their phone number (FSD §5). Viewers get a custom
    // one-session sign-in from redeemLinkToken and are never sharers.
    function isSharer() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'phone';
    }

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/shareSessions/$(sessionId);
    }

    function metaPath(sessionId) {
      return /databases/$(database)/documents/shareSessions/$(sessionId)/private/meta;
    }

    // The owner lives only in private/meta.user_id, never on the session doc.
    function ownsSession(sessionId) {
      return isSharer()
        && exists(metaPath(sessionId))
        && get(metaPath(sessionId)).data.user_id == request.auth.uid;
    }

    // The session as it will be after this write. A batch that also updates the
    // session (Sprint 1: applying precision_next with the next ping) is judged by
    // the precision it sets.
    function sessionAfter(sessionId) {
      return getAfter(sessionPath(sessionId)).data;
    }

    function isLive(s) {
      return s.status == 'active' && request.time < s.expires_at;
    }

    // APPROXIMATE_ROUNDING_METERS in the shared schema.
    function minAccuracyFor(precision) {
      return precision == 'approximate' ? 500 : 0;
    }

    // A ping: exactly lat, lng, recorded_at, accuracy_m (shared Ping).
    function validPing(d, precision) {
      return d.keys().hasOnly(['lat', 'lng', 'recorded_at', 'accuracy_m'])
        && d.keys().hasAll(['lat', 'lng', 'recorded_at', 'accuracy_m'])
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.recorded_at is timestamp
        && d.recorded_at <= request.time + duration.value(1, 'm')
        && d.accuracy_m is number
        && d.accuracy_m >= minAccuracyFor(precision);
    }

    // ---- Sprint 0 live rules ---------------------------------------------

    match /shareSessions/{sessionId} {
      allow get: if ownsSession(sessionId);

      match /private/{docId} {
        allow get: if docId == 'meta' && ownsSession(sessionId);
      }

      match /pings/{pingId} {
        allow create: if ownsSession(sessionId)
          && isLive(sessionAfter(sessionId))
          && validPing(request.resource.data, sessionAfter(sessionId).precision);
      }
    }

    // Everything else, every other write included, is denied by default.

    // ---- Sprint 1 plan (commented out; not live) --------------------------
    //
    // Extra helpers:
    //
    //   // redeemLinkToken mints one custom token per browser with the claims
    //   // {sid, role} (shared ViewerClaims): role 'viewer' for the first
    //   // browser (private/meta.viewer_uid), 'watcher' for any later one.
    //   function isViewerOf(sessionId) {
    //     return signedIn() && request.auth.token.sid == sessionId;
    //   }
    //   function isShareBackViewer(sessionId) {
    //     return isViewerOf(sessionId) && request.auth.token.role == 'viewer'
    //       && get(metaPath(sessionId)).data.viewer_uid == request.auth.uid;
    //   }
    //   function changes(keys) {   // only these fields change
    //     return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    //   }
    //   function shareBackOpen(s) {
    //     return isLive(s) && s.share_back_allowed == true && s.call_active == true
    //       && s.call_ended_at == null
    //       && request.time < s.last_ping_at + duration.value(2, 'm');
    //   }
    //
    // users/{userId}  (§6, §8 Deletion; no phone: Auth holds it)
    //   allow get: if isSharer() && request.auth.uid == userId;
    //   allow create: if isSharer() && request.auth.uid == userId
    //     && keys are exactly name, mascot_id, mascot_color, mascot_accessory,
    //        last_viewer_name, settings, active_session_id, created_at, updated_at
    //     && active_session_id == null
    //     && created_at == request.time && updated_at == request.time
    //     && name is a string, size 1-96 (rules can't count graphemes; the app
    //        and the functions enforce 1-24 graphemes after trimming)
    //     && mascot_accessory fits the mascot (shared mascotTakes)
    //     && settings has exactly the UserSettings keys with valid values;
    //   allow update: if isSharer() && request.auth.uid == userId
    //     && !changes include active_session_id or created_at   // function-owned
    //     && request.resource.data.updated_at == request.time;
    //   allow delete: if false;   // Delete account is a Cloud Function: it stops
    //                             // any session and deletes everything at once,
    //                             // overriding the 30-day retention (§8).
    //
    // users/{userId}/devices/{deviceId}  (§6; deviceId is a per-install UUID;
    // §8: deleted at sign-out or when the token stops working)
    //   allow read, create, update, delete: if isSharer() && request.auth.uid == userId
    //     && keys only platform, push_token, live_activity_start_token, updated_at
    //     && platform in ['ios', 'android'] && updated_at == request.time;
    //
    // users/{userId}/trustedContacts/{id}  (§6: v2, unused in v1)
    //   No rule: stays denied.
    //
    // shareSessions/{sessionId}  (§6)
    //   allow get: if ownsSession(sessionId) || isViewerOf(sessionId);
    //     // The viewer keeps reading the session doc after the end so an open
    //     // page can show the ended state; never pings after the end (below).
    //   allow list, create, delete: if false;   // functions only
    //   allow update (sharer): if ownsSession(sessionId) && isLive(resource.data)
    //     && changes(['last_ping_at', 'ping_interval_s', 'precision', 'precision_next',
    //                 'call_active', 'call_ended_at', 'stop_rule', 'stop_minutes',
    //                 'stop_at', 'share_back_requested_at'])
    //     && request.resource.data.last_ping_at == request.time
    //     && ping_interval_s is number, > 0 and <= 60
    //     && (stop_at unchanged || request.resource.data.stop_at <= resource.data.expires_at)
    //     // call_ended_at is set once; after that call_active can never be true.
    //     && (resource.data.call_ended_at == null
    //         || request.resource.data.call_ended_at == resource.data.call_ended_at)
    //     && (request.resource.data.call_ended_at == null
    //         || request.resource.data.call_active == false)
    //     // Ask to share: once per call, only after the viewer opened the link.
    //     && (share_back_requested_at unchanged
    //         || (resource.data.share_back_requested_at == null
    //             && request.resource.data.share_back_requested_at == request.time
    //             && resource.data.call_active == true
    //             && resource.data.first_viewed_at != null));
    //   Stop sharing: a stopSession callable (it sets status, ended_at,
    //   end_reason 'stopped', clears users.active_session_id and updates the
    //   Live Activity in one place), not a client update.
    //   allow update (viewer): if isShareBackViewer(sessionId)
    //     && changes(['viewer_sharing'])
    //     && (request.resource.data.viewer_sharing == false || shareBackOpen(resource.data));
    //
    // shareSessions/{sessionId}/private/meta  (§6: sharer and functions only)
    //   allow get: if ownsSession(sessionId);
    //   allow update: if ownsSession(sessionId) && changes(['activity_push_token']);
    //   user_id, link_token_hash, viewer_uid and viewer_name are written by
    //   functions. The viewer can never read this doc.
    //
    // shareSessions/{sessionId}/pings/{pingId}  (§6; §8: deleted 24 h after end)
    //   allow create: live above (Sprint 0), unchanged.
    //   allow read: if ownsSession(sessionId)
    //     || (isViewerOf(sessionId) && get(sessionPath(sessionId)).data.status == 'active');
    //   allow update, delete: if false;
    //   Approximate also rounds lat/lng to about 500 m on the phone before the
    //   write; rules check the accuracy floor but can't verify the rounding.
    //
    // shareSessions/{sessionId}/viewerPings/{pingId}  (§6; §8: deleted 24 h after end)
    //   allow read: if ownsSession(sessionId)
    //     || (isShareBackViewer(sessionId) && get(sessionPath(sessionId)).data.status == 'active');
    //   allow create: if isShareBackViewer(sessionId)
    //     && shareBackOpen(get(sessionPath(sessionId)).data)
    //     && validPing(request.resource.data, 'precise');
    //   allow update, delete: if false;
    //
    // mascots/{id}  (§6: the character library; character is the MascotId)
    //   allow read: if isSharer();   // the viewer gets renders from Hosting
    //   allow write: if false;        // seeded from the shared MASCOT_CATALOG
    //
    // callLogs/{id}  (§6; §8: kept 30 days, then purged)
    //   allow create: if isSharer() && request.resource.data.user_id == request.auth.uid
    //     && ownsSession(request.resource.data.session_id)
    //     && keys only user_id, session_id, call_id, call_time
    //     && request.resource.data.call_time == request.time;   // first seen
    //   allow get: if isSharer() && resource.data.user_id == request.auth.uid;
    //   allow update, delete: if false;
    //
    // Lifecycle and retention (§8) run in Cloud Functions, not rules:
    //   - stop sessions at the earlier of stop_at and expires_at, even if the app
    //     was killed; end_reason is 'limit' when stop_at == expires_at, else
    //     'timer'; clear users.active_session_id;
    //   - the watchdog clears call_active when last_ping_at is over 2 min old
    //     (never touching call_ended_at), and stops call-tied sessions 10 min
    //     later; when call_active turns false, set viewer_sharing false;
    //   - delete pings and viewerPings 24 h after ended_at;
    //   - after 30 days delete the session, private/meta and callLogs;
    //   - delete the session's viewer Auth users (one per browser) with the
    //     session's cleanup (§8; whether that's the 24 h or the 30-day pass is
    //     open, see README);
    //   - Delete account removes everything at once.
  }
}
