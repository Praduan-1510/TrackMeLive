{
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "tsconfig*.json",
        "eslint.config.js",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "scripts"
      ]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "auth": { "host": "127.0.0.1", "port": 9199 },
    "firestore": { "host": "127.0.0.1", "port": 8180, "websocketPort": 9250 },
    "functions": { "host": "127.0.0.1", "port": 5101 },
    "hub": { "host": "127.0.0.1", "port": 4410 },
    "logging": { "host": "127.0.0.1", "port": 4510 },
    "eventarc": { "host": "127.0.0.1", "port": 9399 },
    "tasks": { "host": "127.0.0.1", "port": 9599 },
    "ui": { "enabled": false }
  }
}
