{
  "name": "@tml/viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Track Me Live web viewer: the page a viewer opens from a share link, in any browser, no install.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:e2e:live": "vitest run --config e2e/live/vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "axe-core": "4.10.2",
    "eslint": "10.12.0",
    "playwright-core": "1.47.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "firebase": "12.19.0"
  },
  "overrides": {
    "re2js": "2.8.6"
  }
}
