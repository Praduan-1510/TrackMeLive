<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lint runs with warningsAsErrors (app/build.gradle.kts), so the build stays at zero warnings. Only checks
  that contradict a project rule are turned off here, each with the reason.
-->
<lint>
    <!-- Versions are pinned on purpose: exact versions published at least two weeks before they're added,
         and nothing that needs compileSdk 37 (Compose 1.12, androidx.core 1.19, Lifecycle 2.11,
         Navigation 3 1.2). Upgrades are deliberate changes with their own review (README.md › Versions). -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- targetSdk follows compileSdk, which stays at 36 until the dependencies above move to 37. -->
    <issue id="OldTargetApi" severity="ignore" />
</lint>
