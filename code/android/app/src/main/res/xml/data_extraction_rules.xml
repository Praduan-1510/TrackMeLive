<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing is backed up or moved to a new phone. The sign-in is per device, and the profile
     (name, mascot, settings) comes back from the server when someone signs in on a new phone (FSD §4 Sign up). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
